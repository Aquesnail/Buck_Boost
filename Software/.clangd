CompileFlags:
  CompilationDatabase: "build/Debug"
  Add:
    - "-std=c11"
    - "-Wall"
    - "-Wno-invalid-source-encoding"
    # 指定工具链头文件路径，让 clangd 能找到 STM32 寄存器定义
    - "--target=arm-none-eabi"
    - "-mcpu=cortex-m4"
    - "-mfpu=fpv4-sp-d16"
    - "-mfloat-abi=hard"
    - "-isystemD:/environment/arm-gnu-toolchain-15.2.rel1-mingw-w64-i686-arm-none-eabi/arm-none-eabi/include"

Hover:
  ShowAKA: Yes

Diagnostics:
  Suppress: [
      "unused-includes",
      "bugprone-easily-swappable-parameters"
    ]
  ClangTidy:
    Add: [
       bugprone-*,
       readability-identifier-naming
    ]
    Remove: [objc-*]
